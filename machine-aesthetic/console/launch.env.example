# Copy to launch.env and edit paths for your Mac.
# launch.env is gitignored — local only.

# Pure Data binary (optional — macOS usually finds Pd.app automatically)
# export PD_PATH="/Applications/Pd.app/Contents/Resources/bin/pd"

# openFrameworks install (required to build/run native GhostRoom77823)
export OF_ROOT="$HOME/openFrameworks"

# Optional overrides
